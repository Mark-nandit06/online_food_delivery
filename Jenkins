pipeline {
    agent any
    tools {
        maven 'MAVEN_HOME'
    }
    stages {
        stage('Git Clone') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/Mark-nandit06/online_food_delivery.git'
            }
        }
        stage('Clean') {
            steps { bat 'mvn clean' }
        }
        stage('Install') {
            steps { bat 'mvn install' }
        }
        stage('Test') {
            steps { bat 'mvn test' }
        }
        stage('Package') {
            steps { bat 'mvn package' }
        }
    }
}
